PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shoba_creations
DATABASE_SSL=false
# Test isolation uses a dedicated schema rather than a separate database,
# because the application role may not hold the CREATEDB privilege.
DATABASE_SCHEMA=public

# Sessions are httpOnly cookies. Use a long random value.
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Leave false for local http://localhost development; production forces Secure.
COOKIE_SECURE=false

CORS_ORIGIN=http://localhost:5173

# Product image uploads, stored on local disk and served from /uploads.
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_FILES=6

# Commerce rules
FREE_SHIPPING_THRESHOLD=9999
STANDARD_SHIPPING_COST=299
EXPRESS_SHIPPING_COST=599
COD_HANDLING_FEE=50

# Seeded by `npm run db:seed`. Both must be set to create the admin account.
ADMIN_NAME=Meera Chen
ADMIN_EMAIL=admin@shobacreations.com
ADMIN_PASSWORD=Admin@2026
