PORT=3000
NODE_ENV=production

# PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.eofsjyihmocsbmsskabb.supabase.co:5432/postgres
DATABASE_SSL=true
DATABASE_SCHEMA=public

# Sessions are httpOnly cookies. Use a long random value.
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=true

CORS_ORIGIN=https://shobacreations.netlify.app

# Supabase
SUPABASE_URL=https://eofsjyihmocsbmsskabb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# S3-compatible storage (Supabase Storage via S3 API)
S3_ENDPOINT=https://eofsjyihmocsbmsskabb.storage.supabase.co/storage/v1/s3
S3_REGION=ap-northeast-1
S3_BUCKET=product-images

# Commerce rules
FREE_SHIPPING_THRESHOLD=9999
STANDARD_SHIPPING_COST=299
EXPRESS_SHIPPING_COST=599
COD_HANDLING_FEE=50

# Seeded by `npm run db:seed`. Both must be set to create the admin account.
ADMIN_NAME=Meera Chen
ADMIN_EMAIL=admin@shobacreations.com
ADMIN_PASSWORD=Admin@2026